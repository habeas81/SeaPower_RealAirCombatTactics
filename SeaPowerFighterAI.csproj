<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>RealAirCombatTactics</AssemblyName>
    <RootNamespace>SeaPowerFighterAI</RootNamespace>
    <Version>0.9.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    
    <!-- Silences MSB3277 version mismatch warnings between Unity's bundled DLLs and netstandard2.1 -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
    
    <!-- Base directory for the Sea Power installation -->
    <GameDir>E:\SteamLibrary\steamapps\common\Sea Power</GameDir>
    <!-- Managed directory containing game engine and game code assemblies -->
    <ManagedDir>$(GameDir)\Sea Power_Data\Managed</ManagedDir>
    <!-- BepInEx core directory containing modding loader assemblies -->
    <BepInExCore>$(GameDir)\BepInEx\core</BepInExCore>
    <!-- AnchorChain (Steam Workshop item 3380210757), the chainloader that loads this mod from its mod folder -->
    <AnchorChainDll>E:\SteamLibrary\steamapps\workshop\content\1286220\3380210757\AnchorChain.dll</AnchorChainDll>
    <!-- Mod folder the game (and the in-game Steam Workshop uploader) sees, and the distributable copy -->
    <ModFolderName>RealAirCombatTactics</ModFolderName>
    <ModDeployDir>$(GameDir)\Sea Power_Data\StreamingAssets\$(ModFolderName)</ModDeployDir>
  </PropertyGroup>

  <!-- External libraries: BepInEx loader and Harmony patching engine -->
  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCore)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AnchorChain">
      <HintPath>$(AnchorChainDll)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCore)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Unity engine core assemblies -->
  <ItemGroup>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ParadoxNotion">
      <HintPath>$(ManagedDir)\ParadoxNotion.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Entities">
      <HintPath>$(ManagedDir)\Unity.Entities.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Primary Sea Power gameplay assembly containing AI, weapons, and aircraft logic -->
    <Reference Include="Seapower-Scripts">
      <HintPath>$(ManagedDir)\Seapower-Scripts.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UniRx">
      <HintPath>$(ManagedDir)\UniRx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Base type of the doctrine view models (ObservableObject) -->
    <Reference Include="CommunityToolkit.Mvvm">
      <HintPath>$(ManagedDir)\CommunityToolkit.Mvvm.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Referenced only so overload resolution over IniHandler.readValue/writeValue compiles -->
    <Reference Include="Noesis.NoesisGUI">
      <HintPath>$(ManagedDir)\Noesis.NoesisGUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ParticleSystemModule">
      <HintPath>$(ManagedDir)\UnityEngine.ParticleSystemModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Post-build: assemble the mod folder (DLL + _info.ini + thumbnail from workshop\) into dist\ for upload, and mirror it into
       the game's StreamingAssets so it can be enabled in the in-game Mods menu. The legacy BepInEx\plugins copy is removed so the
       mod is never loaded twice. -->
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <ItemGroup>
      <ModFile Include="$(TargetPath)" />
      <ModFile Include="$(MSBuildProjectDirectory)\workshop\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(ModFile)" DestinationFolder="$(MSBuildProjectDirectory)\dist\$(ModFolderName)" />
    <Copy SourceFiles="@(ModFile)" DestinationFolder="$(ModDeployDir)" />
    <Delete Files="$(GameDir)\BepInEx\plugins\SeaPowerFighterAI.dll;$(GameDir)\BepInEx\plugins\$(TargetFileName)" />
    <Message Text="Mod folder deployed to $(ModDeployDir) and packaged in dist\$(ModFolderName)" Importance="high" />
  </Target>
</Project>