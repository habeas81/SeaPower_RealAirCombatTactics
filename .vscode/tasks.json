{
  "version": "2.0.0",
  "tasks": [
    {
      // Label shown in the VS Code Command Palette
      "label": "build",
      // Use the .NET CLI process
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        // Path to the project file to compile
        "${workspaceFolder}/SeaPowerFighterAI.csproj",
        // Ensures clean error and warning reporting in VS Code
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      // Captures C# compiler errors and displays them in the Problems tab
      "problemMatcher": "$msCompile",
      // Marks this as the default build task triggered by Ctrl+Shift+B
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      // Run via Command Palette -> "Tasks: Run Task" -> "Build and Publish to Workshop".
      // Builds first (which stages dist\RealAirCombatTactics\ via the csproj's PostBuild target),
      // then uploads that folder to Steam Workshop with steamcmd. Prompts for your Steam password/
      // Steam Guard code in the terminal on first login; never run automatically from Ctrl+Shift+B.
      "label": "Build and Publish to Workshop",
      "dependsOn": "build",
      "command": "powershell",
      "type": "process",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}/scripts/Publish-Workshop.ps1"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}